# =============================================================================
# AIGMS — variables d'environnement
# Copier vers .env.local (ignore par Git). Ne jamais commiter de valeur reelle.
# =============================================================================

# --- Supabase : exposees au navigateur (lecture soumise a la RLS) ------------
NEXT_PUBLIC_SUPABASE_URL=https://xsagbzrgoljzgorwvsir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase : serveur uniquement -------------------------------------------
# Contourne la RLS. Reserve aux seeds et aux tests d'isolation.
# Ne doit jamais etre lue depuis un composant client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Outillage base de donnees (hors application) ----------------------------
# Jeton personnel Supabase, pour `supabase link` / `supabase db push`.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=xsagbzrgoljzgorwvsir
# Chaine de connexion directe, utilisee par les tests RLS.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Application --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notification des demandes de contact (facultatif) ------------------------
# Sans ces trois variables, une demande est enregistree en base et l'absence de
# notification est journalisee : aucune demande n'est perdue.
#
# L'expediteur doit appartenir a un domaine verifie sur resend.com/domains :
# sans cela le compte reste en mode test et n'accepte que l'adresse
# proprietaire du compte comme destinataire.
# Courrier systeme. Sans ces deux variables, aucun courriel ne part et rien
# n'echoue : l'envoi est une commodite, jamais un point de passage.
RESEND_API_KEY=
SYSTEM_EMAIL_FROM=AIGMS <contact@exemple.fr>

# --- Captcha de la mire de connexion (facultatif) ----------------------------
# Cloudflare Turnstile. DEUX reglages sont necessaires, et le second est celui
# qui protege :
#   1. cette cle publique fait APPARAITRE le defi ;
#   2. Supabase doit etre configure pour l'EXIGER — Authentication > Attack
#      protection > Enable Captcha, fournisseur Turnstile, cle secrete.
# Sans le second, le jeton est envoye mais jamais verifie : un captcha
# decoratif fait croire a une protection qui n'existe pas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# La cle SECRETE du meme widget. Elle ne va PAS dans l'environnement de
# l'application — aucune ligne de code ne la lirait, AIGMS n'appelant jamais
# siteverify. Elle se pose sur Supabase, et ce fichier n'est qu'un relais :
#   npm run captcha:activer   (lit cette valeur, la pose, ne l'affiche jamais)
TURNSTILE_SECRET_KEY=
